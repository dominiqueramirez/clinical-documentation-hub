---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  description = site.description,
  image = '/og-image.png',
  imageAlt = `${site.name}: ${site.tagline}`,
  breadcrumbs,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#162e51" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__top">
        <a class="site-header__title" href="/">
          {site.name}
          <span class="site-header__tag">{site.tagline}</span>
        </a>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <div class="container">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </header>

    <main id="main-content">
      {
        breadcrumbs && (
          <div class="container">
            <va-breadcrumbs
              breadcrumb-list={JSON.stringify(breadcrumbs)}
              label="Breadcrumb"
              home-veterans-affairs="false"
            />
          </div>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__cols">
          <div>
            <h2>Resources</h2>
            <ul>
              <li><a href="/standards">Documentation standards</a></li>
              <li><a href="/templates">Note templates</a></li>
              <li><a href="/quick-reference">Quick reference</a></li>
              <li><a href="/training">Training and job aids</a></li>
            </ul>
          </div>
          <div>
            <h2>Reference</h2>
            <ul>
              <li><a href="/policy">Policy and regulations</a></li>
              <li><a href="/faq">Frequently asked questions</a></li>
              <li><a href="/contact">Contact the documentation team</a></li>
            </ul>
          </div>
          <div>
            <h2>Contact</h2>
            <ul>
              <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
              <li>{site.contactPhone}</li>
            </ul>
          </div>
        </div>
        <p class="site-footer__fine">
          Template site with sample content for demonstration. Not official guidance.
        </p>
      </div>
    </footer>

    <script>
      import { defineCustomElements } from '@department-of-veterans-affairs/web-components/loader';
      defineCustomElements();
    </script>
  </body>
</html>
