---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact and feedback"
  description="Contact the clinical documentation team with questions, template requests, or feedback on this site."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Contact', href: '/contact' },
  ]}
>
  <PageHeader
    title="Contact and feedback"
    lede="Questions about documentation, a template request, or feedback on this site."
  />
  <div class="container page-body prose">
    <h2>Documentation team</h2>
    <ul>
      <li>Email: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
      <li>Phone: {site.contactPhone}</li>
      <li>Hours: Monday to Friday, 8:00 a.m. to 4:30 p.m. (sample)</li>
    </ul>

    <h2>What to include</h2>
    <ul>
      <li>For a template request: the clinical use case and a draft layout.</li>
      <li>For a specificity question: the diagnosis in question and your clinical setting.</li>
      <li>For feedback: the page address and what could be clearer.</li>
    </ul>

    <va-alert status="warning" visible>
      <h2 slot="headline">Do not send patient information</h2>
      <p class="demo-note">Never include protected health information in email or feedback.</p>
    </va-alert>
  </div>
</BaseLayout>
